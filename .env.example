# ---- Database (MySQL) ----
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=trading

# ---- 行情缓存 MCP 服务 (tt-serve) ----
# 同样读取上面的 DB_*；DB 账号需要 trading_data 与两张旁表（market_data_meta / market_corporate_actions）的读写和建表权限。
# 缺 DB_* 或缺 token 配置时 tt-serve 启动即失败，不会无鉴权运行。
MCP_HOST=127.0.0.1
MCP_PORT=8765
# token 只存 sha256：`uv run tt-serve gen-token --name agent-a --scopes read` 生成后，
# 把输出的 JSON 条目放进下面的数组（scopes: read / refresh / backtest）。
# MCP_TOKENS='[{"name":"agent-a","scopes":["read"],"sha256":"<64 位十六进制>"}]'
# 也可以改用文件（同样的 JSON 数组），与 MCP_TOKENS 可同时使用：
# MCP_TOKENS_FILE=/run/secrets/tt_mcp_tokens.json
# 可选：每个 token 每分钟的调用上限 / 回测限制 / 反 DNS-rebinding 的 Host 白名单
# MCP_RATE_LIMIT_READ_PER_MIN=120
# MCP_RATE_LIMIT_REFRESH_PER_MIN=10
# MCP_RATE_LIMIT_BACKTEST_PER_MIN=6
# MCP_BACKTEST_CONCURRENCY=2
# MCP_BACKTEST_MAX_SPAN_DAYS=3660
# MCP_BACKTEST_MAX_SYMBOLS=20
# MCP_ALLOWED_HOSTS=market.example.com

# ---- SMTP (optional, for email notifications) ----
SMTP_SERVER=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=

# ---- Cloudflare (used by frontend deploy workflow) ----
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# ---- PushGo (daily signal digest notifications) ----
PUSHGO_CHANNEL_ID=
PUSHGO_PASSWORD=
PUSHGO_URL=https://gateway.pushgo.dev/push
