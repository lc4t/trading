# ---- Database (MySQL) ----
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=trading

# ---- 行情缓存 MCP 服务 (trading-mcp) ----
# 同样读取上面的 DB_*；DB 账号需要 trading_data 与两张旁表（market_data_meta / market_corporate_actions）的读写和建表权限。
# 缺 DB_* 时 trading-mcp 启动即失败；鉴权无法关闭，没配 token 时会自动生成（见下）。
MCP_HOST=127.0.0.1
MCP_PORT=8765
# 鉴权默认开启且无法关闭。token 来源（可组合）：
#   1) MCP_TOKEN：单个 token，权限默认 read（MCP_TOKEN_SCOPES 可改，逗号分隔 read/refresh/backtest），至少 24 个字符
#   2) MCP_TOKENS / MCP_TOKENS_FILE：多个，只存 sha256（`trading-mcp gen-token --name agent-a --scopes read` 生成条目）
#   3) 什么都没配：首次启动自动生成一个 read token，启动日志里只显示这一次明文，哈希写进 MCP_CONFIG_DIR/tokens.json；
#      之后用 `trading-mcp token new|rotate|list` 管理
# MCP_TOKEN=
# MCP_TOKENS='[{"name":"agent-a","scopes":["read"],"sha256":"<64 位十六进制>"}]'
# MCP_TOKENS_FILE=/run/secrets/tt_mcp_tokens.json
# 自动生成/管理的 token 文件所在目录（镜像里默认 /data/config，请挂卷；本机默认也是它，不可写时请改成可写目录）
# MCP_CONFIG_DIR=/data/config
# 可选：每个 token 每分钟的调用上限 / 回测限制 / 反 DNS-rebinding 的 Host 白名单
# MCP_RATE_LIMIT_READ_PER_MIN=120
# MCP_RATE_LIMIT_REFRESH_PER_MIN=10
# MCP_RATE_LIMIT_BACKTEST_PER_MIN=6
# MCP_BACKTEST_CONCURRENCY=2
# MCP_BACKTEST_MAX_SPAN_DAYS=3660
# MCP_BACKTEST_MAX_SYMBOLS=20
# MCP_ALLOWED_HOSTS=market.example.com
# 账号只有 SELECT 时会自动进入只读模式（不建表、不写库、不回源）；也可显式指定
# MCP_READ_ONLY=1

# ---- SMTP (optional, for email notifications) ----
SMTP_SERVER=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=

# ---- Cloudflare (used by frontend deploy workflow) ----
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# ---- PushGo (daily signal digest notifications) ----
PUSHGO_CHANNEL_ID=
PUSHGO_PASSWORD=
PUSHGO_URL=https://gateway.pushgo.dev/push
